NODE_ENV=development
PORT=4000
# Local SQLite database; no server installation needed.
DATABASE_URL="file:./dev.db"
# Replace with a long, random secret before deployment.
JWT_SECRET="dev-only-change-this-to-a-long-random-secret-before-deploying-9f81b5d0"
JWT_EXPIRES_IN=1d
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=admin@123
# Exact frontend origins, comma-separated. Do not add a trailing slash.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
